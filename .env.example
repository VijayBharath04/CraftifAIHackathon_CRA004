# AI Guardian Configuration
# Copy this file to .env and adjust variables as needed

# Server Network Settings
HOST=127.0.0.1
PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# Computer Vision & Inference Parameters
CONFIDENCE_THRESHOLD=0.45
DETECTION_INTERVAL_MS=150
WARNING_BUFFER_PX=40
DEDUPLICATION_COOLDOWN_S=3.0

# Storage & Snapshots
SNAPSHOT_ENABLED=true

# Operational Mode
DEFAULT_MODE=REAL
